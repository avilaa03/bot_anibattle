TOKEN=
LOGS=
PREFIX=
# Inclua o nome do banco no caminho da URI (ex: /AnimeFightDB antes do "?"),
# senão o driver conecta no banco padrão "test" e todas as queries voltam vazias.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/AnimeFightDB?appName=AnimeFightDB
CLIENT_ID=
# Cooldown do /roll em milissegundos. Se não definido, usa 15 minutos (900000).
ROLL_COOLDOWN_MS=900000
# Porta do servidor HTTP de health-check (opcional, padrão 3000).
PORT=3000
# Taxa cobrada nas vendas do mercado (0.05 = 5%). Essa moeda é destruída,
# e é o principal freio contra a inflação da economia.
MARKET_TAX_RATE=0.05
# Aposta mínima obrigatória em uma batalha.
MIN_WAGER=10
# Escala global do valor das cartas (1 = tabela padrão de utils/valores.js).
# Serve para calibrar a economia sem alterar código: subir isto encarece
# tudo proporcionalmente e mantém a hierarquia entre raridades. A primeira
# semana depois da virada de preços é a que mais pede ajuste.
# ATENÇÃO: mexer aqui NÃO reprecifica o acervo já existente — para isso
# rode `npm run migrar:valores -- --confirmar` depois de reiniciar o bot.
VALOR_MULTIPLICADOR=1
# Chance de sair uma Mestra no /roll, em porcentagem (0.1 = 1 em 1.000).
# A Comum absorve a diferença sozinha, então a soma continua fechando 100.
#
# A sensação de "evento do servidor" não depende desta taxa e sim do
# volume de rolls do servidor inteiro: com 10 jogadores ativos, 0.1 dá uma
# Mestra a cada ~3 dias; com 50, a cada ~16 horas. Passando de ~40
# jogadores ativos, caia para 0.05 ou a Mestra vira rotina.
CHANCE_MESTRA=0.1
# Proteção contra azar: rolls seguidos sem a raridade (ou melhor) até o
# jogo garantir uma. Existe porque probabilidade independente é cruel — o
# sorteio não deve nada a quem está sem sorte, e essa pessoa não pensa
# "estou na cauda ruim da distribuição": ela acha que o bot está quebrado.
#
# São duas redes porque são duas frustrações diferentes. Ultra Rara+ é 11%
# por roll (uma a cada 9), então 40 secos são o 1% mais azarado. Lendária+
# é 1,2% (uma a cada 83), e 300 secos são o pior ~3% — é esse o azar que
# faz alguém desistir.
#
# Não existe garantia de Mestra, de propósito: Mestra entregue por tempo
# de espera deixa de ser sorte e vira mensalidade.
ROLLS_ATE_ULTRA_GARANTIDA=40
ROLLS_ATE_LENDARIA_GARANTIDA=300
# Intervalo mínimo entre duas batalhas do MESMO par de jogadores (ms).
# Sem isso, dois amigos conseguem duelar em loop.
BATTLE_COOLDOWN_MS=60000
# Depois disso, uma batalha parada é considerada abandonada: as apostas
# voltam para os jogadores e o registro é apagado (padrão 30 min).
BATTLE_TTL_MS=1800000
# Segredo do webhook de pagamento. Gere um valor longo e aleatório, por
# exemplo com: openssl rand -hex 32
# Se não for definido, o endpoint de webhook fica DESLIGADO (mais seguro
# do que existir sem senha).
PAYMENT_WEBHOOK_SECRET=
# URL da sua página de assinatura, exibida como botão no /vip (opcional).
LOJA_URL=
# --- Cartas animadas (molduras VIP de Ouro para cima) ---
# Menos quadros e menos largura = arquivo mais leve e geração mais rápida.
# Rode "npm run preview:cards -- --molduras" para medir antes de mexer.
CARD_GIF_FRAMES=16
CARD_GIF_DELAY_MS=70
CARD_GIF_WIDTH=400
# Se o GIF demorar mais que isso, a carta sai como PNG estático.
CARD_GIF_TIMEOUT_MS=8000
# --- Monitoramento (opcional, mas recomendado antes do beta) ---
# npm install @sentry/node e cole o DSN do seu projeto aqui.
# Sem isso, os erros vão só para o console.
SENTRY_DSN=
SENTRY_TRACES_RATE=0.05