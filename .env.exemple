TOKEN=
LOGS=
PREFIX=
# Inclua o nome do banco no caminho da URI (ex: /AnimeFightDB antes do "?"),
# senão o driver conecta no banco padrão "test" e todas as queries voltam vazias.
MONGODB_URI=mongodb+srv://usuario:senha@cluster.mongodb.net/AnimeFightDB?appName=AnimeFightDB
CLIENT_ID=
# Cooldown do /roll em milissegundos. Se não definido, usa 15 minutos (900000).
ROLL_COOLDOWN_MS=900000
# Porta do servidor HTTP de health-check (opcional, padrão 3000).
PORT=3000
# Taxa cobrada nas vendas do mercado (0.05 = 5%). Essa moeda é destruída,
# e é o principal freio contra a inflação da economia.
MARKET_TAX_RATE=0.05
# Aposta mínima obrigatória em uma batalha.
MIN_WAGER=10
# Intervalo mínimo entre duas batalhas do MESMO par de jogadores (ms).
# Sem isso, dois amigos conseguem duelar em loop.
BATTLE_COOLDOWN_MS=60000